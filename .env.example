# =============================================================================
# Chang Arena NFT Ticketing System - Environment Configuration Template
# เครือข่าย : Polygon Amoy Testnet (PoS) & Supabase PostgreSQL
# =============================================================================

# 1. การตั้งค่าบล็อกเชน Polygon Amoy (Web3 Configuration)
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME=Polygon Amoy Testnet
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com

# ที่อยู่ Smart Contract ของ ChangArenaNFT ที่ Deploy ผ่าน Remix IDE
NEXT_PUBLIC_CONTRACT_ADDRESS=0x4376f92025De220677102e3b2eE9B1F54B06922C

# 2. การตั้งค่าฐานข้อมูล Off-chain (Supabase PostgreSQL - PDPA Compliant)
# คัดลอกได้จากเมนู Project Settings -> API บนแดชบอร์ด Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. การตั้งค่าพื้นที่จัดเก็บไฟล์รูปตั๋วและ Metadata (Pinata IPFS)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
PINATA_JWT=your_pinata_jwt_token
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# 4. การตั้งค่าความปลอดภัยของ Dynamic QR (Anti-Screenshot Security)
# อายุสูงสุดของ QR Code (วินาที) เพื่อป้องกันการแคปภาพหน้าจอส่งต่อ
NEXT_PUBLIC_QR_MAX_AGE_SECONDS=60
NEXT_PUBLIC_QR_REFRESH_INTERVAL_SECONDS=30
